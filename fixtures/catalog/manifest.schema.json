{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pacote local de catálogo RetroVault v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "version", "captured_at", "actor", "records"],
  "properties": {
    "source": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "records": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["id", "file"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"}, "file": {"type": "string", "pattern": "^[A-Za-z0-9_-]+\\.json$"}}}}
  }
}
