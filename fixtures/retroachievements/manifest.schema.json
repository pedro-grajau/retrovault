{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetroAchievements Get Game manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "version", "captured_at", "actor", "record_ids"],
  "properties": {
    "source": {"const": "retroachievements"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "actor": {"const": "Eduardo"},
    "record_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  }
}
